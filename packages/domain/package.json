{
  "name": "@nabd/domain",
  "private": true,
  "version": "0.0.0",
  "description": "Domain logic shared by web and mobile: candle math, the chart summary, custom range validation. Pure functions, no platform",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@nabd/shared": "workspace:*"
  },
  "devDependencies": {
    "@nabd/config": "workspace:*",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
