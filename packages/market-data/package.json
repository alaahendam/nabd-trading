{
  "name": "@nabd/market-data",
  "private": true,
  "version": "0.0.0",
  "description": "Live prices shared by web and mobile: the price store, the realtime client over Socket.IO, staleness, and the React bindings",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@nabd/shared": "workspace:*",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@nabd/config": "workspace:*",
    "@nabd/testing": "workspace:*",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
