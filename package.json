{
  "name": "nabd-trading",
  "private": true,
  "version": "1.0.0",
  "description": "Nabd: a mini trading app with live simulated market data",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=12.23.0 <13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:root && pnpm lint:css",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint --allow-empty-input \"**/*.css\"",
    "prepare": "husky",
    "lint:root": "eslint --max-warnings 0 .",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nabd/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
