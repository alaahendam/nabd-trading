# Copy to .env and fill in. Nothing here is a secret: EXPO_PUBLIC_ values are visible in the app.
# The app has no default for this value. Without it, it shows a configuration error screen.

# The API the app talks to, with its scheme and no trailing slash. Pick one:
#
# The deployed API (see docs/deployment.md):
EXPO_PUBLIC_API_URL=https://nabdserver-production-5845f39b.up.railway.app
#
# The Android emulator, with the API running on your computer (10.0.2.2 is the emulator's name for
# your computer; Android blocks plain http outside development builds):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# A phone on the same Wi-Fi, with the API running on your computer (your computer's address):
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
#
# The APK gets this value from EAS environment configuration, never from a file in git.
